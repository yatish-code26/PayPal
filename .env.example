# =============================================================================
# FreightGuard Environment Configuration Template
# Autonomous Freight Invoice Audit, Evidence Intelligence & PayPal Settlement
# =============================================================================

# Application Operational Mode:
# 'LOCAL_DEMO' : High-fidelity deterministic simulation (100% offline, zero keys required)
# 'LIVE_SANDBOX': Live PayPal Developer Sandbox and real LLM inference
FREIGHTGUARD_MODE=LOCAL_DEMO

# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000

# Session Token Signing Secret (used by itsdangerous for role-based sessions)
SESSION_SECRET=fg_sec_token_09871234567890abcdef_change_me_in_prod

# Local HMAC Secret for Webhook Signature Verification in LOCAL_DEMO mode
WEBHOOK_LOCAL_HMAC_SECRET=fg_local_webhook_secret_hmac_2026

# =============================================================================
# PayPal Developer Sandbox Credentials (Optional for local testing)
# Obtain these from: https://developer.paypal.com/dashboard/applications/sandbox
# =============================================================================
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_SANDBOX_BASE_URL=https://api-m.sandbox.paypal.com

# =============================================================================
# AI Model Provider Credentials (Optional — defaults to high-fidelity offline simulation)
# Support Groq (llama-3.3-70b), Gemini (gemini-2.0-flash), or OpenAI (gpt-4o-mini)
# =============================================================================
AI_PROVIDER=LOCAL_DETERMINISTIC
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
